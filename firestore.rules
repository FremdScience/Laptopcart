rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isD211Teacher() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@d211[.]org$');
    }

    function hasValidBookingShape(bookingId) {
      return request.resource.data.keys().hasOnly([
          'id', 'date', 'period', 'cart', 'room', 'teacherName',
          'teacherEmail', 'ownerUid', 'createdAt', 'seriesId'
        ])
        && request.resource.data.id == bookingId
        && (
          (request.resource.data.cart == 'Cart #1'
            && bookingId == request.resource.data.date + '_cart-1_' + string(request.resource.data.period))
          ||
          (request.resource.data.cart == 'Cart #2'
            && bookingId == request.resource.data.date + '_cart-2_' + string(request.resource.data.period))
        )
        && request.resource.data.date is string
        && request.resource.data.date.matches('202[6-7]-[0-1][0-9]-[0-3][0-9]')
        && request.resource.data.date >= '2026-08-10'
        && request.resource.data.date <= '2027-05-20'
        && request.resource.data.period is int
        && request.resource.data.period >= 1
        && request.resource.data.period <= 8
        && request.resource.data.cart in ['Cart #1', 'Cart #2']
        && request.resource.data.room is string
        && request.resource.data.room.size() > 0
        && request.resource.data.room.size() <= 12
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 100
        && request.resource.data.teacherEmail is string
        && request.resource.data.ownerUid is string
        && request.resource.data.createdAt is string
        && request.resource.data.seriesId is string;
    }

    match /bookings/{bookingId} {
      allow read: if isD211Teacher();
      allow create: if isD211Teacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.teacherEmail == request.auth.token.email
        && hasValidBookingShape(bookingId);
      allow update: if isD211Teacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['room'])
        && request.resource.data.room is string
        && request.resource.data.room.size() > 0
        && request.resource.data.room.size() <= 12;
      allow delete: if isD211Teacher() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
